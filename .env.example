# ==============================================================================
# Solis-Inverter AI Configuration
# ==============================================================================

# Backend Port (default: 4000)
PORT=4000

# Frontend Port (default: 3000 or custom like 9999)
FRONTEND_PORT=9999

# Model Context Protocol (MCP) Server Port (default: 1234)
MCP_PORT=1234

# SolisCloud API Settings
# Regional SolisCloud API endpoint:
# Global/Default: https://www.soliscloud.com:13333
# Europe:         https://eu.soliscloud.com:13333
# Australia:      https://au.soliscloud.com:13333
SOLIS_API_URL=https://www.soliscloud.com:13333

# SolisCloud API Credentials (obtain from SolisCloud Web Portal -> Account -> API Management)
SOLIS_KEY_ID=
SOLIS_KEY_SECRET=
SOLIS_STATION_ID=
SOLIS_INVERTER_SN=

# Mock Mode (default: true)
# Set to 'false' when using live SolisCloud credentials.
# Set to 'true' to run simulation with realistic solar/battery/grid dynamics.
SOLIS_MOCK_MODE=true
